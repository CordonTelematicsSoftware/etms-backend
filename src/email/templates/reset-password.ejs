<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZainSpot</title>
</head>

<body>
  <table border="0" cellpadding="0" cellspacing="0" width="100%"
    style="table-layout: fixed; background-color: #f9f9f9; padding-top: 100px" id="bodyTable">
    <tbody>
      <tr>
        <td style="padding-right: 10px; padding-left: 10px" align="center" valign="top" id="bodyCell">
          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapperWebview"
            style="max-width: 900px">
            <tbody>
              <tr style="padding: 50px">
                <td align="center" valign="top">
                  <table border="0" cellpadding="0" cellspacing="0" width="100%">
                    <tbody>
                      <tr style="
                            background: #ffffff;
                            box-shadow: 0px 4px 9px -7px rgba(0, 0, 0, 0.25);
                          ">
                        <td style="
                              padding-top: 20px;
                              padding-bottom: 20px;
                              padding-right: 0px;
                            " align="left" valign="middle" class="webview">
                          <a href="#" style="
                                color: #bbb;
                                font-family: 'Open Sans', Helvetica, Arial,
                                  sans-serif;
                                font-size: 12px;
                                font-weight: 400;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 20px;
                                text-transform: none;
                                text-align: right;
                                text-decoration: underline;
                                padding: 0;
                                margin: 0;
                              " target="_blank" class="text hideOnMobile">
                            <!-- <img
                                src="https://s3.ap-south-1.amazonaws.com/processmap.techtaliya.com/static/techtaliya-logo.png"
                                alt="techtaliya Image"
                                width="200"
                                height="100"
                              /> -->
                          </a>
                        </td>
                        <td style="
                              padding-top: 20px;
                              padding-bottom: 20px;
                              padding-right: 0px;
                            " align="right" valign="middle" class="webview">
                          <!-- <a
                              href="#"
                              style="
                                color: blue;
                                font-family: 'Open Sans', Helvetica, Arial,
                                  sans-serif;
                                font-size: 12px;
                                font-weight: 400;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 20px;
                                text-transform: none;
                                text-align: right;
                                text-decoration: underline;
                                padding-right: 30px;
                                margin: 0;
                              "
                              target="_blank"
                              class="text hideOnMobile"
                              >https://techtaliya.com</a
                            > -->
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapperBody" style="max-width: 900px">
            <tbody>
              <tr>
                <td align="center" valign="top">
                  <table border="0" cellpadding="0" cellspacing="0" width="100%" height="100px" class="tableCard" style="
                        background: linear-gradient(
                            240.48deg,
                            #0954ae -491.54%,
                            rgba(9, 84, 174, 0) 66.23%
                          ),
                          #ffffff;
                      ">
                    <tbody>
                      <tr>
                        <td style="
                              padding-bottom: 5px;
                              padding-left: 20px;
                              padding-top: 30px;
                              padding-right: 20px;
                            " align="center" valign="top" class="mainTitle">
                          <h2 class="text" style="
                                color: #000;
                                font-family: Poppins, Helvetica, Arial,
                                  sans-serif;
                                font-size: 28px;
                                font-weight: 500;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 36px;
                                text-transform: none;
                                text-align: center;
                                padding: 0;
                                margin: 0;
                              ">
                            Reset Password
                          </h2>
                        </td>
                      </tr>
                      <tr>
                        <td style="
                              padding-bottom: 30px;
                              padding-top: 30px;
                              padding-left: 20px;
                              padding-right: 20px;
                            " align="center" valign="top" class="subTitle">
                          <h4 class="text" style="
                                color: #999;
                                font-family: Poppins, Helvetica, Arial,
                                  sans-serif;
                                font-size: 16px;
                                font-weight: 500;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 24px;
                                text-transform: none;
                                text-align: justify;
                                padding: 0;
                                margin: 0;
                              ">
                            <p>Hello <%= name %>,
                            </p>
                            <p>Welcome to Smart Router</p>
                            <p>Forgot your assword ?</p>
                            <p>
                              We received a request to reset the password for
                              your account.
                            </p>
                            <p>Please use this link below to</p>
                            <p style="text-align: justify">
                              <a href="<%= link %>" target="_blank">Reset your password</a>
                            </p>
                          </h4>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
            </tbody>
          </table>
          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="wrapperFooter" style="
                max-width: 900px;
                background-size: cover;
                background-position: center;
              ">
            <tbody>
              <tr>
                <td align="center" valign="top">
                  <table border="0" cellpadding="0" cellspacing="0" width="100%" class="footer">
                    <tbody>
                      <tr style="background-color: #0954ae" width="10px" height="100px" paddingBottom="100px">
                        <td style="padding: 30px 10px 5px" align="center" valign="top" class="brandInfo" width="500px"
                          background-color: #0954ae;>
                          <h3 style="
                                color: #bbb;
                                font-family: 'Open Sans', Helvetica, Arial,
                                  sans-serif;
                                background-color: #0954ae;
                              ">
                            Smart Router©.
                          </h3>
                          <p class="text" style="
                                background-color: #0954ae;
                                color: #bbb;
                                font-family: 'Open Sans', Helvetica, Arial,
                                  sans-serif;
                                font-size: 15px;
                                font-weight: 400;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 20px;
                                text-transform: none;
                                text-align: center;
                                padding: 0;
                                margin: 0;
                                height: 110px;
                              ">
                          </p>
                          <p class="text" style="
                                background-color: #0954ae;
                                color: #bbb;
                                font-family: 'Open Sans', Helvetica, Arial,
                                  sans-serif;
                                font-size: 15px;
                                font-weight: 400;
                                font-style: normal;
                                letter-spacing: normal;
                                line-height: 20px;
                                text-transform: none;
                                text-align: center;
                                padding: 0;
                                margin: 0;
                              "></p>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding-left: 20px; padding-right: 20px" align="center" valign="top"
                          class="containtTable ui-sortable">
                          <table border="0" cellpadding="0" cellspacing="0" width="100%" class="tableButton" style="">
                            <tbody>
                              <tr>
                                <td style="
                                      padding-top: 20px;
                                      padding-bottom: 20px;
                                    " align="center" valign="top"></td>
                              </tr>
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </td>
              </tr>
              <tr>
                <td style="font-size: 1px; line-height: 1px" height="30">
                  &nbsp;
                </td>
              </tr>
            </tbody>
          </table>
        </td>
      </tr>
    </tbody>
  </table>
</body>

</html>