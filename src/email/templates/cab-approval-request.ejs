<!DOCTYPE html>
<html>

<body style="font-family: Arial, sans-serif; padding: 20px;">
  <h2>Cab Update Request</h2>

  <p>
    Vendor <strong>
      <%= vendorName %>
    </strong> has requested changes to the cab
    <strong>
      <%= registerNumber %>
    </strong>.
  </p>

  <p>
    <strong>Request submitted by:</strong>
    <%= requestedByEmail %>
  </p>

  <p>
    Please review the requested updates below.
  </p>
  <table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse;">
    <thead>
      <tr>
        <th>Field</th>
        <th>Old Value</th>
        <th>New Value</th>
      </tr>
    </thead>
    <tbody>
      <% function formatKey(key) { return key .replace(/([A-Z])/g, ' $1' ) .trim() .replace(/\b\w/g, function(c) {
        return c.toUpperCase(); }); } Object.keys(newRecord).forEach(function(key) { %>
        <tr>
          <td>
            <%= formatKey(key) %>
          </td>

          <td>
            <% if (key==='documents' ) { %>
              <% if (oldRecord.documents && oldRecord.documents.length) { %>
                <ul style="margin:0;padding-left:18px;">
                  <% oldRecord.documents.forEach(function(doc){ %>
                    <li>
                      <%= doc.title %>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                  N/A
                  <% } %>
                    <% } else { %>
                      <%= oldRecord[key] || 'N/A' %>
                        <% } %>
          </td>

          <td>
            <% if (key==='documents' ) { %>
              <% if (newRecord.documents && newRecord.documents.length) { %>
                <ul style="margin:0;padding-left:18px;">
                  <% newRecord.documents.forEach(function(doc){ %>
                    <li>
                      <%= doc.title %>
                    </li>
                    <% }) %>
                </ul>
                <% } else { %>
                  N/A
                  <% } %>
                    <% } else { %>
                      <%= newRecord[key] %>
                        <% } %>
          </td>
        </tr>
        <% }) %>
    </tbody>
  </table>

  <br />
  <a href="<%= deepLink %>"
    style="background-color:#1976d2;color:#fff;padding:10px 20px;text-decoration:none;border-radius:4px;">
    Review Pending Requests
  </a>
</body>

</html>