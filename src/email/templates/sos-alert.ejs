<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; padding: 20px;">
  <h2 style="color:#d32f2f;">🚨 SOS Alert Raised</h2>
  <p>An SOS alert has been raised by <strong><%= raisedBy %></strong>.</p>

  <table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse;">
    <thead>
      <tr>
        <th>Field</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Raised By</td>
        <td><%= raisedBy %></td>
      </tr>
      <tr>
        <td>Trip ID</td>
        <td><%= tripID %></td>
      </tr>
      <tr>
        <td>Date &amp; Time</td>
        <td><%= dateTime %></td>
      </tr>
      <tr>
        <td>Vehicle</td>
        <td><%= vehicle %></td>
      </tr>
      <tr>
        <td>Location</td>
        <td><%= location %></td>
      </tr>
    </tbody>
  </table>

  <br/>
  <a href="<%= trackLink %>"
     style="background-color:#d32f2f;color:#fff;padding:10px 20px;text-decoration:none;border-radius:4px;">
    Track Location
  </a>
</body>
</html>