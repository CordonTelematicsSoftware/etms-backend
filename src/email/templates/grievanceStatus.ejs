<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Grievance Status Update</title>
  </head>

  <body style="margin:0; background-color:#f2f3f8;">
    <table width="100%" cellpadding="0" cellspacing="0" style="font-family:'Open Sans',sans-serif; background:#f2f3f8;">
      <tr><td height="60"></td></tr>

      <tr>
        <td>
          <table width="100%" align="center" cellpadding="0" cellspacing="0" style="max-width:700px; margin:0 auto;">
            <tr>
              <td>
                <table width="95%" align="center" cellpadding="0" cellspacing="0" style="max-width:670px; background:#ffffff; border-radius:3px; box-shadow:0 6px 18px rgba(0,0,0,0.06);">
                  
                  <tr><td height="40"></td></tr>

                  <tr>
                    <td style="padding:0 35px; text-align:center;">
                      <h1 style="color:#337ab7; font-size:28px; margin:0; font-weight:600;">Grievance Status Updated</h1>

                      <span style="display:inline-block; width:100px; border-bottom:1px solid #cecece; margin:20px 0;"></span>

                      <p style="color:#455056; font-size:15px; line-height:24px; text-align:left; margin:0;">
                        The status of your grievance has been updated to 
                        <strong><%= status %></strong>.
                        Please review the latest details.
                      </p>

                      <br/>

                      

                     

                     

                    </td>
                  </tr>

                  <tr><td height="40"></td></tr>

                </table>
              </td>
            </tr>

            <tr><td height="60"></td></tr>
          </table>
        </td>
      </tr>

    </table>
  </body>
</html>
