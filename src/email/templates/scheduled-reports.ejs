<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> <%= reportName %></title>
  </head>

  <body style="margin: 0; background-color: #f9f9f9">
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background-color: #f9f9f9; padding: 80px 0"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="
              max-width: 900px;
              background: #ffffff;
              box-shadow: 0px 4px 9px -7px rgba(0, 0, 0, 0.25);
            "
          >
            <!-- Header -->
            <tr>
              <td
                align="center"
                style="
                  background: linear-gradient(
                      240.48deg,
                      #0954ae -491.54%,
                      rgba(9, 84, 174, 0) 66.23%
                    ),
                    #ffffff;
                  padding: 30px 20px;
                "
              >
                <h2
                  style="
                    margin: 0;
                    color: #000;
                    font-family: Poppins, Helvetica, Arial, sans-serif;
                    font-size: 28px;
                    font-weight: 500;
                    line-height: 36px;
                  "
                >
                   <%= reportName %>
                </h2>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style="padding: 30px 40px">
                <p
                  style="
                    color: #455056;
                    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
                    font-size: 15px;
                    line-height: 24px;
                    margin: 0;
                    text-align: left;
                  "
                >
                 Hello,
                 <br />
                  Please find the  <%= reportName %> attached along with this mail.
                </p>
                <br />
                <p
                  style="
                    color: #455056;
                    font-size: 14px;
                    line-height: 22px;
                    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
                    text-align: left;
                  "
                >
                  If you have any questions, please contact the support team.
                </p>

                <br />

                <p
                  style="
                    color: #6a6a6a;
                    font-size: 13px;
                    line-height: 20px;
                    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
                    text-align: left;
                  "
                >
                  This is an automated email. Please do not reply.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align="center"
                style="background-color: #0954ae; padding: 30px 20px"
              >
                <h3
                  style="
                    color: #bbb;
                    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
                    font-size: 15px;
                    font-weight: 400;
                    margin: 0;
                  "
                >
                  Smart Router©
                </h3>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
