<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; padding: 20px;">
  <h2>Employee Profile Update Request</h2>
  <p>Employee <strong><%= employeeName %></strong> has requested a home geocode change.</p>

  <table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse;">
    <thead>
      <tr>
        <th>Field</th>
        <th>Old Value</th>
        <th>New Value</th>
      </tr>
    </thead>
    <tbody>
      <%
        function formatKey(key) {
          return key
            .replace(/([A-Z])/g, ' $1')
            .trim()
            .replace(/\b\w/g, function(c) { return c.toUpperCase(); });
        }
        Object.keys(newRecord).forEach(function(key) {
      %>
      <tr>
        <td><%= formatKey(key) %></td>
        <td><%= oldRecord[key] || 'N/A' %></td>
        <td><%= newRecord[key] %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>

  <br/>
  <a href="<%= deepLink %>" 
     style="background-color:#1976d2;color:#fff;padding:10px 20px;text-decoration:none;border-radius:4px;">
    Review Pending Requests
  </a>
</body>
</html>