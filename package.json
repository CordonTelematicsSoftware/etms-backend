{
  "name": "etms-nest",
  "version": "0.0.1",
  "description": "",
  "author": "TechTaliya Informatics Pvt Ltd",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "commit": "cz",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set STAGE=dev&&nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "docker": "node $(npm bin)/serverless offline start --host 0.0.0.0",
    "start:docker": "nodemon",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky install",
    "pm2:deploy:app": "npm run build && pm2 start app.json",
    "pm2:start:app": "pm2 start app.json",
    "pm2:stop:app": "pm2 stop app.json",
    "pm2:destroy:app": "pm2 delete app.json"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1130.0",
    "@aws-sdk/client-sns": "^3.1033.0",
    "@aws-sdk/client-sqs": "^3.1033.0",
    "@googlemaps/routing": "^1.4.0",
    "@nestjs-modules/mailer": "^1.9.1",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^9.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/platform-socket.io": "^9.4.3",
    "@nestjs/schedule": "^2.2.3",
    "@nestjs/sequelize": "^10.0.0",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.1.16",
    "@nestjs/websockets": "^9.4.3",
    "@playwright/test": "^1.41.2",
    "@sparticuz/chromium": "^126.0.0",
    "@vendia/serverless-express": "^4.10.4",
    "archiver": "^7.0.1",
    "aws-lambda": "^1.0.7",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.7",
    "basic-ftp": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cz-conventional-changelog": "^3.3.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express-basic-auth": "^1.2.1",
    "firebase-admin": "^12.2.0",
    "googleapis": "^140.0.1",
    "json2csv": "^6.0.0-alpha.2",
    "jspdf": "^2.5.1",
    "libphonenumber-js": "^1.10.55",
    "luxon": "^3.7.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "playwright-aws-lambda": "^0.11.0",
    "playwright-core": "^1.40.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "sequelize": "^6.36.0",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.3",
    "ssh2-sftp-client": "^10.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.4",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^16.0.0",
    "@types/sequelize": "^4.28.19",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.3",
    "jest": "28.1.2",
    "lint-staged": "^15.2.0",
    "prettier": "^2.3.2",
    "serverless-jetpack": "^0.11.2",
    "serverless-offline": "^14.4.0",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.5",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.0.0",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "**/{src,apps,libs,test}/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
