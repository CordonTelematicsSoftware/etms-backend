<!doctype html>
<html>
  <head>
    <style>
      @page {
        margin-top: 50px;
        padding: 50px;
        margin-bottom: 50px;
        margin-right: 50px;
      }
      body {
        padding: 50px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 60px;
      }
      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 50px;
        text-align: center;
        line-height: 50px;
      }
      tr {
        margin-top: 20px;
      }
      h3 {
        margin-top: 0;
      }
      th,
      td {
        border: 0.25px solid gray;
        line-height: 40px;
        text-align: center;
        font-size: 9px;
        margin-top: 200px;
        white-space: nowrap;
      }
      tr {
        border-bottom: 0.25px solid gray;
      }
    </style>
  </head>
  <body>
    <h3>
      6 ആം വക്കുപ്പനുസരിച്ചുള്ള അപേക്ഷാഫോറം
    </h3>
    <h2>എസ്.എൻ.ഡി.പി യോഗം</h2>
    <h3>സ്ഥിരാംഗമാകാനുളള അപേക്ഷ</h3>
    <table>
      <thead>
       
      </thead>
      <tbody>
        <tr>
          പൂർണമായ പേര്  <%= memberDetails.data.member.fullNameEng %>---------------------
        </tr>
        <tr>
          മേൽവിലാസം    ---------------------
        </tr>
        <tr>
          ജനനതിയതി    ---------------------
        </tr>
        <tr>ഏത് ശാഖയിൽ സ്ഥിരമായി താമസിക്കുന്നു എന്ന് ----------------------

        </tr>
        <tr>ഏത് യൂണിയനിൽപ്പെടുന്നു എന്ന്------------------------------------</tr>
      </tbody>
      <p>ഞാൻ ശ്രീനാരായണ ധർമ്മത്തിൽ വിശ്വാസിക്കുന്നു എന്നും എസ്.എൻ.ഡി.പി യോഗത്തിൻ്റെ നിബന്ധനകൾക്കും
        നിർദേശങ്ങൾക്കും വിധേയമായി പ്രവർത്തിച്ചുകൊള്ളാമെന്നും ഇതിനാൽ പ്രതിഞ്ജ 
      </p>
    </table>
  </body>
</html> 